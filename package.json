{
  "description": "Provide Node-based deployment wizard to Google App Engine",
  "type": "module",
  "scripts": {
    "build": "op run --env-file ./.env -- webpack",
    "deploy": "run-s deploy:**",
    "deploy:build": "run-s build",
    "deploy:spa-template": "move-file ./public/index.html ./views/SPA.php",
    "#deploy:deploy": "node ./scripts/deploy.js -v",
    "deploy:deploy": "node ./scripts/deploy.js -v --serviceAccountToken=\"$(op item get OP_SERVICE_ACCOUNT_TOKEN --fields credential --reveal)\""
  },
  "dependencies": {
    "@groton/canvas-api.client.web": "0.0.1-3",
    "bootstrap": "^5.3.7"
  },
  "devDependencies": {
    "@battis/descriptive-types": "^0.2.3",
    "@battis/partly-gcloudy": "^1.4.1",
    "@battis/typescript-tricks": "^0.7.4",
    "@battis/webpack": "^2.0.6",
    "@inquirer/input": "^4.2.1",
    "@qui-cli/colors": "^3.0.1",
    "@qui-cli/core": "^4.0.1",
    "@qui-cli/env": "^4.0.1",
    "@qui-cli/log": "^3.0.1",
    "@qui-cli/root": "^3.0.1",
    "@qui-cli/shell": "^3.0.1",
    "@qui-cli/validators": "^3.0.1",
    "move-file-cli": "^3.0.0",
    "npm-run-all": "^4.1.5"
  },
  "packageManager": "pnpm@10.13.1+sha512.37ebf1a5c7a30d5fabe0c5df44ee8da4c965ca0c5af3dbab28c3a1681b70a256218d05c81c9c0dcf767ef6b8551eb5b960042b9ed4300c59242336377e01cfad"
}
